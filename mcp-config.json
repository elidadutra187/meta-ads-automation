{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/mcp-config-schema.json",
  "mcpServers": {

    "meta-ads-oficial": {
      "type": "url",
      "url": "https://mcp.facebook.com/ads",
      "description": "Meta Ads MCP Oficial - Campanhas Facebook/Instagram"
    },

    "google-analytics-4": {
      "type": "url",
      "url": "https://mcp-ga.stape.ai/mcp",
      "description": "Google Analytics 4 - Metricas, sessoes, conversoes, relatorios"
    },

    "google-tag-manager": {
      "type": "url",
      "url": "https://gtm-mcp.stape.ai/mcp",
      "description": "Google Tag Manager - Tags, triggers, variaveis, containers"
    },

    "stape-server": {
      "type": "url",
      "url": "https://mcp.stape.ai/mcp",
      "description": "Stape Server - Containers e zones"
    },

    "meta-ads-pipeboard": {
      "command": "npx",
      "args": ["-y", "@anthropic-community/meta-ads-mcp"],
      "env": {
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "META_AD_ACCOUNT_ID": "${META_AD_ACCOUNT_ID}",
        "META_PAGE_ID": "${FACEBOOK_PAGE_ID}"
      },
      "description": "Meta Ads Community - Ferramentas completas"
    },

    "saldao-local": {
      "command": "python",
      "args": ["-m", "src.mcp_server"],
      "cwd": "C:\\Users\\elida\\Desktop\\GitHub-Prep\\meta-ads-automation",
      "env": {
        "OLLAMA_MODEL": "llama3.2"
      },
      "description": "Servidor local Saldao - Copy com Ollama + automacoes"
    }
  }
}
