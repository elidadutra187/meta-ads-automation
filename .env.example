# ===========================================
# META ADS AUTOMATION - CONFIGURAÇÕES
# ===========================================
# Copie este arquivo para .env e preencha seus dados

# --- META / FACEBOOK ---
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui
META_ACCESS_TOKEN=seu_access_token_aqui
META_AD_ACCOUNT_ID=seu_ad_account_id_sem_act

# --- CONFIGURAÇÕES DE CAMPANHA ---
# Página do Facebook (obrigatório)
FACEBOOK_PAGE_ID=seu_page_id

# Instagram (opcional)
INSTAGRAM_ACCOUNT_ID=seu_instagram_id

# --- OLLAMA (IA LOCAL) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- COMPOSIO (opcional, etapa online) ---
# Nunca coloque a chave real em arquivos versionados.
COMPOSIO_API_KEY=sua_chave_composio_aqui

# --- BIGQUERY / LOOKER STUDIO ---
# Projeto e dataset usados pelo pacote looker_studio/*.sql
BIGQUERY_PROJECT_ID=seu-projeto-google-cloud
BIGQUERY_DATASET_ID=mcp_marketing_ops
# Opcional: caminho de um service account JSON local, fora do Git.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# --- MULTIGROW WEBHOOK PUSH ---
# Cole este valor no campo "Token de autenticação" da Multigrow.
# Use um token forte e mantenha fora do Git.
MULTIGROW_WEBHOOK_AUTH=Bearer seu_token_forte_aqui

# --- CAMINHOS ---
CRIATIVOS_PATH=./criativos
LOGS_PATH=./logs

# --- OTIMIZAÇÃO ---
# CPA máximo antes de pausar (em centavos)
MAX_CPA=5000
# ROAS mínimo antes de pausar
MIN_ROAS=1.5
# Budget diário padrão (centavos)
DEFAULT_DAILY_BUDGET=5000
